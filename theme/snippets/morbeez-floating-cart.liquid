<a
  href="{{ routes.cart_url }}"
  class="morbeez-floating-cart fixed bottom-24 right-3 z-30 flex flex-col items-center gap-1 rounded-xl bg-[var(--color-primary)] px-2.5 py-3 text-white shadow-lg transition hover:brightness-110 sm:bottom-28 sm:right-4 lg:hidden"
  aria-label="{{ 'general.cart' | t }}"
  style="background: var(--gradient-brand);"
>
  {%- render 'morbeez-icon', name: 'cart', class: 'h-6 w-6' -%}
  <span class="text-xs font-bold" data-morbeez-cart-count>{{ cart.item_count }}</span>
</a>
