{% comment %}
  Product rating — always visible on PDP/cards.
  Prefers reviews / morbeez metafields; hydrates from farmer reviews API when blank.
  @param {product} product
  @param {string} [class]
  @param {boolean} [show_link] — link count to #product-reviews (PDP)
{% endcomment %}
{%- liquid
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.morbeez.rating
  assign count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: product.metafields.morbeez.rating_count
  if rating != blank
    assign rating_num = rating | plus: 0
  else
    assign rating_num = 0
  endif
  assign has_meta = false
  if rating != blank
    assign has_meta = true
  endif
-%}
<div
  class="morbeez-rating {{ class }}"
  data-morbeez-rating
  data-product-id="{{ product.id }}"
  data-has-meta="{% if has_meta %}true{% else %}false{% endif %}"
  {% if show_link %}data-link-reviews="true"{% endif %}
  aria-label="{% if has_meta %}{{ rating_num }} out of 5{% if count != blank %}, {{ count }} reviews{% endif %}{% else %}Product rating{% endif %}"
>
  <span class="morbeez-rating__stars" data-rating-stars aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg class="morbeez-rating__star {% if has_meta and i <= rating_num %}is-filled{% elsif has_meta == false %}is-muted{% endif %}" viewBox="0 0 20 20" fill="currentColor">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    {%- endfor -%}
  </span>
  {%- if show_link -%}
    <a href="#product-reviews" class="morbeez-rating__count" data-rating-count>
      {%- if has_meta and count != blank -%}
        ({{ count }} reviews)
      {%- else -%}
        (Reviews)
      {%- endif -%}
    </a>
  {%- else -%}
    <span class="morbeez-rating__count" data-rating-count>
      {%- if has_meta and count != blank -%}
        ({{ count }})
      {%- endif -%}
    </span>
  {%- endif -%}
</div>
