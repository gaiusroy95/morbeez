<section class="morbeez-section morbeez-section--tight !py-4" id="MorbeezCrops-{{ section.id }}">
  <div class="morbeez-container">
    {%- if section.settings.heading != blank -%}
      <div class="morbeez-browse-section__header">
        <h2 class="morbeez-browse-section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.more_label != blank -%}
          <a href="{{ section.settings.more_url | default: '/collections' }}" class="morbeez-browse-section__view-all">
            {{ section.settings.more_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="morbeez-icon-chip-grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- if coll != blank -%}
          {%- assign tile_url = coll.url -%}
          {%- assign tile_title = block.settings.title | default: coll.title -%}
          {%- assign tile_image = block.settings.image | default: coll.image -%}
        {%- else -%}
          {%- assign tile_url = block.settings.link -%}
          {%- assign tile_title = block.settings.title -%}
          {%- assign tile_image = block.settings.image -%}
        {%- endif -%}
        {%- if tile_title != blank -%}
          {%- capture tile_href -%}
            {%- render 'morbeez-safe-collection-url',
              collection: coll,
              url: tile_url,
              label: tile_title,
              fallback: 'search'
            -%}
          {%- endcapture -%}
          {%- assign tile_href = tile_href | strip -%}
          <div class="morbeez-icon-chip-grid__item" role="listitem" {{ block.shopify_attributes }}>
            {%- render 'morbeez-icon-chip',
              image: tile_image,
              icon: block.settings.icon,
              title: tile_title,
              url: tile_href
            -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.crop_categories.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.crop_categories.settings.heading", "default": "Shop by crop" },
    { "type": "text", "id": "more_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "more_url", "label": "View all URL" }
  ],
  "blocks": [
    {
      "type": "category_tile",
      "name": "t:sections.crop_categories.blocks.tile.name",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🌿" },
        { "type": "collection", "id": "collection", "label": "t:sections.crop_categories.blocks.tile.settings.collection" },
        { "type": "image_picker", "id": "image", "label": "t:sections.crop_categories.blocks.tile.settings.image" },
        { "type": "text", "id": "title", "label": "t:sections.crop_categories.blocks.tile.settings.title" },
        { "type": "url", "id": "link", "label": "t:sections.crop_categories.blocks.tile.settings.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.crop_categories.presets.default",
      "blocks": [
        { "type": "category_tile", "settings": { "icon": "🫚", "title": "Ginger", "link": "/collections/all" } },
        { "type": "category_tile", "settings": { "icon": "🍌", "title": "Banana", "link": "/collections/all" } },
        { "type": "category_tile", "settings": { "icon": "🌶️", "title": "Pepper", "link": "/collections/all" } },
        { "type": "category_tile", "settings": { "icon": "🌿", "title": "Cardamom", "link": "/collections/all" } },
        { "type": "category_tile", "settings": { "icon": "🥥", "title": "Coconut", "link": "/collections/all" } },
        { "type": "category_tile", "settings": { "icon": "🌾", "title": "Paddy", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
