<section class="morbeez-trust" id="MorbeezTrust-{{ section.id }}">
  <div class="morbeez-container">
    <div class="morbeez-trust__card">
      {%- for block in section.blocks -%}
        <div class="morbeez-trust__item" {{ block.shopify_attributes }}>
          <span class="morbeez-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                {%- render 'morbeez-icon', name: 'truck', class: 'h-6 w-6' -%}
              {%- when 'shield' -%}
                {%- render 'morbeez-icon', name: 'shield', class: 'h-6 w-6' -%}
              {%- when 'support' -%}
                {%- render 'morbeez-icon', name: 'phone', class: 'h-6 w-6' -%}
              {%- else -%}
                {%- render 'morbeez-icon', name: 'leaf', class: 'h-6 w-6' -%}
            {%- endcase -%}
          </span>
          <p class="morbeez-trust__title">{{ block.settings.title }}</p>
          <p class="morbeez-trust__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.trust_features.name",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.trust_features.blocks.feature.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.trust_features.blocks.feature.settings.icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Quality" },
            { "value": "support", "label": "Support" },
            { "value": "leaf", "label": "Organic" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "t:sections.trust_features.blocks.feature.settings.title", "default": "Fast delivery" },
        { "type": "text", "id": "text", "label": "t:sections.trust_features.blocks.feature.settings.text", "default": "Pan-India shipping on agri inputs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_features.presets.default",
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "title": "Fast Delivery", "text": "Reliable shipping across India" } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Quality Assured", "text": "Tested & science-backed products" } },
        { "type": "feature", "settings": { "icon": "support", "title": "Expert Support", "text": "WhatsApp advisory by agronomists" } },
        { "type": "feature", "settings": { "icon": "leaf", "title": "Farmer First", "text": "Solutions designed for real field results" } }
      ]
    }
  ]
}
{% endschema %}
