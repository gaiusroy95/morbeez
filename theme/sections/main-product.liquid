<section class="morbeez-section" id="MorbeezProduct-{{ section.id }}">
  <div class="morbeez-container">
    {%- render 'morbeez-breadcrumbs' -%}
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-4">
        {%- liquid
          assign hero_image = product.featured_image
          if product.images.size > 1
            assign hero_image = product.images[1]
          endif
          assign variant_img = product.selected_or_first_available_variant.featured_image
          if variant_img != blank and product.images.size > 0 and variant_img.src != product.images.first.src
            assign hero_image = variant_img
          endif
        -%}
        {%- if hero_image -%}
          <div class="morbeez-product-card__media overflow-hidden rounded-xl border border-gray-100" id="MorbeezProduct-main">
            {%- render 'morbeez-lazy-image',
              image: hero_image,
              alt: product.title,
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600,800,1000,1400',
              sizes: '(min-width: 1024px) 50vw, 100vw',
              class: 'morbeez-product-card__img',
              id: 'MorbeezProduct-main-image'
            -%}
          </div>
        {%- endif -%}
        {%- if product.images.size > 1 -%}
          <div class="morbeez-product-thumbs flex gap-2 overflow-x-auto" data-product-thumbs>
            {%- for image in product.images -%}
              {%- if forloop.index0 == 1 -%}
                {%- render 'morbeez-product-thumb', image: image, alt: product.title, active: true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for image in product.images -%}
              {%- if forloop.index0 != 1 -%}
                {%- render 'morbeez-product-thumb', image: image, alt: product.title, active: false -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="morbeez-product-buy">
        {%- liquid
          assign pdp_name = product.metafields.morbeez.card_title | strip
          assign pdp_benefit = product.metafields.morbeez.short_benefit | strip
          if pdp_name == blank
            assign title_parts = product.title | split: '|'
            if title_parts.size > 1
              assign pdp_name = title_parts.first | strip
              if pdp_benefit == blank
                assign pdp_benefit = title_parts[1] | strip
              endif
            else
              assign pdp_name = product.title
            endif
          endif
        -%}
        <h1 class="font-heading text-2xl font-bold tracking-tight text-[var(--color-trust)] md:text-[1.75rem]">{{ pdp_name }}</h1>
        {%- if pdp_benefit != blank -%}
          <p class="mt-1 text-sm text-[var(--color-muted)]">{{ pdp_benefit }}</p>
        {%- endif -%}
        {%- render 'morbeez-rating-stars', product: product, class: 'mt-2', show_link: true -%}

        {%- if product.metafields.morbeez.target_crops.value.size > 0 -%}
          <div class="mt-3 flex flex-wrap gap-2">
            {%- for crop in product.metafields.morbeez.target_crops.value -%}
              <span class="rounded-full bg-[var(--color-surface)] px-2 py-1 text-xs font-medium">{{ crop }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- form 'product', product, id: 'product-form', class: 'mt-5', data-product-form: '' -%}
          <div class="morbeez-product-buy__price-row">
            <div data-product-price-wrap>
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="text-[1.75rem] font-extrabold leading-none text-[var(--color-primary)]" data-product-price>
                  {%- render 'morbeez-money', amount: product.selected_or_first_available_variant.price -%}
                </span>
                <s class="text-base text-[var(--color-muted)] hidden" data-product-compare-price></s>
                <span class="morbeez-pack-savings hidden" data-product-savings></span>
              </div>
            </div>

            <div class="morbeez-qty-stepper" data-qty-stepper>
              <span class="morbeez-qty-stepper__label">{{ 'products.quantity' | t }}</span>
              <div class="morbeez-qty-stepper__controls">
                <button type="button" class="morbeez-qty-stepper__btn morbeez-qty-stepper__btn--minus" data-qty-minus aria-label="Decrease quantity">−</button>
                <input
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  class="morbeez-qty-stepper__input"
                  data-qty-input
                  aria-label="{{ 'products.quantity' | t }}"
                >
                <button type="button" class="morbeez-qty-stepper__btn morbeez-qty-stepper__btn--plus" data-qty-plus aria-label="Increase quantity">+</button>
              </div>
            </div>
          </div>

          {%- unless product.has_only_default_variant -%}
            <div class="mt-6">
              {%- render 'morbeez-variant-picker', product: product, section_id: section.id -%}
            </div>
          {%- else -%}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              data-variant-picker-card
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-variant-title="{{ product.selected_or_first_available_variant.title | escape }}"
              data-price="{{ product.selected_or_first_available_variant.price }}"
              data-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price | default: 0 }}"
              data-available="{% if product.selected_or_first_available_variant.available %}true{% else %}false{% endif %}"
            >
          {%- endunless -%}

          <div class="morbeez-product-buy__total">
            <span>{{ 'products.total' | t }}</span>
            <span class="morbeez-product-buy__total-price" data-product-total>
              {%- render 'morbeez-money', amount: product.selected_or_first_available_variant.price -%}
            </span>
          </div>

          <div class="morbeez-product-buy__actions">
            <button
              type="submit"
              name="add"
              class="morbeez-btn-primary morbeez-product-buy__add w-full border-0 {% unless product.available %}opacity-50 cursor-not-allowed{% endunless %}"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- render 'morbeez-icon', name: 'cart', class: 'h-5 w-5' -%}
              <span>
                {%- if product.available -%}
                  {{ 'products.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>
            <button
              type="button"
              class="morbeez-btn-secondary morbeez-product-buy__buy w-full {% unless product.available %}opacity-50 cursor-not-allowed{% endunless %}"
              data-buy-now
              {% unless product.available %}disabled{% endunless %}
            >
              {{ 'products.buy_now' | t }}
            </button>
            <p class="morbeez-product-buy__secure">
              {%- render 'morbeez-icon', name: 'shield', class: 'h-4 w-4' -%}
              <span>{{ 'products.safe_payments' | t }}</span>
            </p>
          </div>
        {%- endform -%}

        {%- if product.metafields.morbeez.waiting_period_days != blank -%}
          <p class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
            {{ 'products.waiting_period' | t: days: product.metafields.morbeez.waiting_period_days }}
          </p>
        {%- endif -%}
      </div>
    </div>

    <div class="mt-12 border-t border-gray-100 pt-8">
      {%- render 'morbeez-product-tabs' -%}
    </div>

    <div class="mt-10" id="product-reviews">
      {%- render 'morbeez-farmer-reviews', product: product -%}
      {%- for block in section.blocks -%}
        {%- render block -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- render 'schema-product' -%}
{%- render 'schema-faq' -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": [],
  "blocks": [{ "type": "@app" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
