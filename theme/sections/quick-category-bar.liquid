<section class="morbeez-section morbeez-section--tight !py-4" id="MorbeezQuickCategories-{{ section.id }}" aria-label="{{ 'sections.quick_category_bar.name' | t }}">
  <div class="morbeez-container">
    <div class="morbeez-icon-chip-grid" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- capture chip_url -%}
            {%- render 'morbeez-safe-collection-url',
              collection: block.settings.collection,
              url: block.settings.url,
              label: block.settings.label,
              fallback: 'search'
            -%}
          {%- endcapture -%}
          {%- assign chip_url = chip_url | strip -%}
          {%- assign chip_label = block.settings.label -%}
          {%- if block.settings.collection != blank and chip_label == blank -%}
            {%- assign chip_label = block.settings.collection.title -%}
          {%- endif -%}
          {%- assign chip_image = block.settings.icon -%}
          {%- assign chip_emoji = block.settings.emoji -%}
          {%- assign is_more = false -%}
          {%- assign label_down = chip_label | downcase -%}
          {%- if label_down contains 'shop all' or label_down contains 'view all' or label_down contains 'more' -%}
            {%- assign is_more = true -%}
          {%- endif -%}

          <div class="morbeez-icon-chip-grid__item" role="listitem" {{ block.shopify_attributes }}>
            {%- if is_more -%}
              <a href="{{ chip_url }}" class="morbeez-icon-chip morbeez-icon-chip--more group">
                <span class="morbeez-icon-chip__circle morbeez-icon-chip__circle--more" aria-hidden="true">
                  <span class="morbeez-icon-chip__plus">+</span>
                </span>
                <span class="morbeez-icon-chip__label">{{ chip_label }}</span>
              </a>
            {%- else -%}
              {%- render 'morbeez-icon-chip',
                image: chip_image,
                icon: chip_emoji,
                title: chip_label,
                url: chip_url
              -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign quick_collections = 'bio-fertilizers,bio-pesticides,organic-inputs,micronutrients' | split: ',' -%}
        {%- assign quick_emojis = '🌱,🛡️,🍃,⚗️' | split: ',' -%}
        {%- for handle in quick_collections -%}
          {%- assign coll = collections[handle] -%}
          {%- if coll != blank -%}
            <div class="morbeez-icon-chip-grid__item" role="listitem">
              {%- render 'morbeez-icon-chip',
                image: coll.image,
                icon: quick_emojis[forloop.index0],
                title: coll.title,
                url: coll.url
              -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        <div class="morbeez-icon-chip-grid__item" role="listitem">
          <a href="{{ routes.all_products_collection_url }}" class="morbeez-icon-chip morbeez-icon-chip--more group">
            <span class="morbeez-icon-chip__circle morbeez-icon-chip__circle--more" aria-hidden="true">
              <span class="morbeez-icon-chip__plus">+</span>
            </span>
            <span class="morbeez-icon-chip__label">Shop All</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.quick_category_bar.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "chip",
      "name": "t:sections.quick_category_bar.blocks.chip.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.quick_category_bar.blocks.chip.settings.label", "default": "Category" },
        { "type": "text", "id": "emoji", "label": "Emoji icon", "default": "🌿" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "url", "label": "t:sections.quick_category_bar.blocks.chip.settings.url", "info": "Used only if no collection is selected. Missing collections fall back to product search." },
        { "type": "image_picker", "id": "icon", "label": "t:sections.quick_category_bar.blocks.chip.settings.icon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.quick_category_bar.presets.default",
      "blocks": [
        { "type": "chip", "settings": { "label": "Bio Fertilizers", "emoji": "🌱", "url": "/collections/bio-fertilizers" } },
        { "type": "chip", "settings": { "label": "Bio Pesticides", "emoji": "🛡️", "url": "/collections/bio-pesticides" } },
        { "type": "chip", "settings": { "label": "Organic Inputs", "emoji": "🍃", "url": "/collections/organic-inputs" } },
        { "type": "chip", "settings": { "label": "Micronutrients", "emoji": "⚗️", "url": "/collections/micronutrients" } },
        { "type": "chip", "settings": { "label": "Shop All", "url": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
