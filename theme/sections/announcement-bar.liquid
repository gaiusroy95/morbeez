{%- liquid
  assign heading = section.settings.heading | default: section.settings.message
  assign subheading = section.settings.subheading
  assign cta_label = section.settings.cta_label | default: 'Chat Now'
  assign wa_phone = settings.whatsapp_phone | default: '917676026318'
-%}
{%- if heading != blank -%}
  {%- capture wa_href -%}
    {%- render 'morbeez-whatsapp-url', phone_raw: wa_phone, message_raw: settings.whatsapp_message -%}
  {%- endcapture -%}
  {%- assign cta_href = section.settings.link | default: wa_href | strip -%}
  <div
    class="morbeez-announce"
    role="region"
    aria-label="{{ 'sections.announcement.name' | t }}"
  >
    <div class="morbeez-announce__inner">
      <span class="morbeez-announce__icon" aria-hidden="true">
        {%- render 'morbeez-icon', name: 'whatsapp', class: 'h-5 w-5' -%}
      </span>
      <div class="morbeez-announce__copy">
        <p class="morbeez-announce__title">{{ heading }}</p>
        {%- if subheading != blank -%}
          <p class="morbeez-announce__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
      {%- if cta_href != blank -%}
        <a
          href="{{ cta_href }}"
          class="morbeez-announce__cta"
          {%- if cta_href contains 'wa.me' %} target="_blank" rel="noopener noreferrer"{% endif -%}
        >
          {{ cta_label }}
          {%- render 'morbeez-icon', name: 'whatsapp', class: 'h-3.5 w-3.5' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Free crop advisory on WhatsApp"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Send crop photo • Get expert advice"
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:sections.announcement.settings.message",
      "info": "Fallback if heading is empty."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Chat Now" },
    { "type": "url", "id": "link", "label": "t:sections.announcement.settings.link", "info": "Leave blank to open WhatsApp." }
  ]
}
{% endschema %}
